# Production build values for Birelle (used by `next build` on Vercel/AWS).
# PUBLIC values only. Secrets go in the hosting dashboard, never in this file:
#   EDGE_SHARED_SECRET   - production edge secret (from the Zcom backend team)
#   GITHUB_TOKEN         - shared read token that installs @zcom/storefront-kit
#                          (Vercel team shared variable; or KIT_DEPLOY_KEY_B64)
# .env.local (your machine) overrides this file, so local dev is unaffected.

# Zcom store: Birelle. The backend picks the store by this domain; it must be
# VERIFIED for Birelle in Zcom (placeholder until Birelle has a real domain).
NEXT_PUBLIC_TENANT_DOMAIN=birelle.in
ZCOM_STORE_SLUG=birelle
API_GATEWAY_URL=https://api.zerrorstudios.com

# Where the site is served (links, sitemap, SEO, payment return)
NEXT_PUBLIC_SITE_URL=https://birelle.vercel.app
NEXT_PUBLIC_STORE_CURRENCY=INR

# Test deployment: keep it out of search engines. Remove at go-live.
SITE_NOINDEX=true

